    {"note": "below: above 102% re-arms", "direction": "below", "threshold": 5000, "state": "fired", "latest": 5101, "previous": 4000, "expect_state": "armed", "expect_fired": false},
    {"note": "below: re-arm needs both days present", "direction": "below", "threshold": 5000, "state": "fired", "latest": 5101, "previous": null, "expect_state": "fired", "expect_fired": false},
